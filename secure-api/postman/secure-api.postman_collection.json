{
  "info": {
    "name": "Secure Expense Reports API",
    "description": "OAuth2 password flow, JWT bearer tokens and rate limiting.\n\nRun the requests in order. `Sign in` saves the tokens into collection variables, so every request after it is authorised without pasting a token anywhere.\n\nThe folders are:\n\n- **Auth** getting, inspecting and refreshing tokens\n- **Reports** the protected endpoints\n- **Rejected** the failures, each asserting the status it should get\n\nEvery request has tests, so `newman run` is a usable check on the whole API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "username", "value": "manager" },
    { "key": "password", "value": "manager-password" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "created_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Health (no token)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] },
            "description": "The one endpoint that needs no token."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 without a token', () => pm.response.to.have.status(200));",
              "pm.test('reports the auth scheme', () => {",
              "  pm.expect(pm.response.json().authentication).to.include('OAuth2');",
              "});"
            ]}
          }]
        },
        {
          "name": "Sign in",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "{{username}}" },
                { "key": "password", "value": "{{password}}" }
              ]
            },
            "url": { "raw": "{{base_url}}/auth/token", "host": ["{{base_url}}"], "path": ["auth", "token"] },
            "description": "The OAuth2 password grant. Form fields, not JSON. The test script saves both tokens into collection variables."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('returns both tokens', () => {",
              "  pm.expect(body.access_token).to.be.a('string').and.not.empty;",
              "  pm.expect(body.refresh_token).to.be.a('string').and.not.empty;",
              "});",
              "pm.test('is a bearer token that expires', () => {",
              "  pm.expect(body.token_type).to.eql('bearer');",
              "  pm.expect(body.expires_in).to.be.above(0);",
              "});",
              "pm.test('grants the manager scopes', () => {",
              "  pm.expect(body.scope).to.eql('reports:read reports:write');",
              "});",
              "pm.test('the JWT payload names the subject and scopes', () => {",
              "  const claims = JSON.parse(atob(body.access_token.split('.')[1]));",
              "  pm.expect(claims.sub).to.eql(pm.collectionVariables.get('username'));",
              "  pm.expect(claims.type).to.eql('access');",
              "  pm.expect(claims.scopes).to.include('reports:read');",
              "});",
              "pm.collectionVariables.set('access_token', body.access_token);",
              "pm.collectionVariables.set('refresh_token', body.refresh_token);"
            ]}
          }]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] },
            "description": "Reads the identity back out of the token that was just saved."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('is the account that signed in', () => {",
              "  pm.expect(body.username).to.eql(pm.collectionVariables.get('username'));",
              "});",
              "pm.test('carries the expected scopes', () => {",
              "  pm.expect(body.scopes).to.eql(['reports:read', 'reports:write']);",
              "});",
              "pm.test('the token has an id and an expiry', () => {",
              "  pm.expect(body.token_id).to.not.be.empty;",
              "  pm.expect(body.token_expires_at > body.token_issued_at).to.be.true;",
              "});"
            ]}
          }]
        },
        {
          "name": "Refresh the access token",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{refresh_token}}", "type": "string" }] },
            "method": "POST",
            "url": { "raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth", "refresh"] },
            "description": "Sends the refresh token instead of the access token, and gets a fresh access token back."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('returns a new access token', () => {",
              "  pm.expect(body.access_token).to.not.eql(pm.collectionVariables.get('access_token'));",
              "});",
              "pm.collectionVariables.set('access_token', body.access_token);"
            ]}
          }]
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "List reports",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/reports", "host": ["{{base_url}}"], "path": ["reports"] },
            "description": "Needs reports:read."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('count matches the rows returned', () => {",
              "  pm.expect(body.reports).to.have.lengthOf(body.count);",
              "});",
              "pm.test('every report has the documented fields', () => {",
              "  body.reports.forEach(r => pm.expect(r).to.have.all.keys(",
              "    'id', 'title', 'category', 'amount', 'submitted_by', 'status', 'created_at'));",
              "});"
            ]}
          }]
        },
        {
          "name": "List reports filtered by category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/reports?category=travel",
              "host": ["{{base_url}}"], "path": ["reports"],
              "query": [{ "key": "category", "value": "travel" }]
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('only travel comes back', () => {",
              "  pm.response.json().reports.forEach(r => pm.expect(r.category).to.eql('travel'));",
              "});"
            ]}
          }]
        },
        {
          "name": "Totals by category",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/reports/summary", "host": ["{{base_url}}"], "path": ["reports", "summary"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('the categories add up to the total', () => {",
              "  const sum = Object.values(body.by_category).reduce((a, b) => a + b, 0);",
              "  pm.expect(Math.round(sum * 100) / 100).to.eql(body.total_amount);",
              "});"
            ]}
          }]
        },
        {
          "name": "Create a report",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Client workshop, Iloilo\",\n  \"category\": \"travel\",\n  \"amount\": 9800\n}"
            },
            "url": { "raw": "{{base_url}}/reports", "host": ["{{base_url}}"], "path": ["reports"] },
            "description": "Needs reports:write, which the analyst account does not have."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('the server assigned an id', () => pm.expect(body.id).to.be.above(0));",
              "pm.test('attributed to the signed in user', () => {",
              "  pm.expect(body.submitted_by).to.eql(pm.collectionVariables.get('username'));",
              "});",
              "pm.test('starts out pending', () => pm.expect(body.status).to.eql('pending'));",
              "pm.collectionVariables.set('created_id', body.id);"
            ]}
          }]
        },
        {
          "name": "Read the report just created",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/reports/{{created_id}}",
              "host": ["{{base_url}}"], "path": ["reports", "{{created_id}}"]
            }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('is the one that was created', () => {",
              "  pm.expect(Number(pm.response.json().id)).to.eql(Number(pm.collectionVariables.get('created_id')));",
              "  pm.expect(pm.response.json().title).to.eql('Client workshop, Iloilo');",
              "});"
            ]}
          }]
        }
      ]
    },
    {
      "name": "Rejected",
      "item": [
        {
          "name": "No token at all (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/reports", "host": ["{{base_url}}"], "path": ["reports"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "pm.test('asks for a bearer token', () => {",
              "  pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer');",
              "});"
            ]}
          }]
        },
        {
          "name": "Tampered token (401)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}x", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/reports", "host": ["{{base_url}}"], "path": ["reports"] },
            "description": "One extra character on the end of a valid token, so the signature no longer matches."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "pm.test('the refusal names the signature', () => {",
              "  pm.expect(pm.response.json().message.toLowerCase()).to.include('signature');",
              "});"
            ]}
          }]
        },
        {
          "name": "Refresh token used as an access token (401)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{refresh_token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{base_url}}/reports", "host": ["{{base_url}}"], "path": ["reports"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "pm.test('the type claim is what refused it', () => {",
              "  pm.expect(pm.response.json().message).to.include('access token');",
              "});"
            ]}
          }]
        },
        {
          "name": "Wrong password (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "manager" },
                { "key": "password", "value": "not-the-password" }
              ]
            },
            "url": { "raw": "{{base_url}}/auth/token", "host": ["{{base_url}}"], "path": ["auth", "token"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "pm.test('does not say whether the user exists', () => {",
              "  pm.expect(pm.response.json().message).to.eql('Incorrect username or password.');",
              "});"
            ]}
          }]
        },
        {
          "name": "Delete without the scope (403)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/reports/{{created_id}}",
              "host": ["{{base_url}}"], "path": ["reports", "{{created_id}}"]
            },
            "description": "The manager token is valid and carries write, but not delete. Authenticated, not authorised."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('403, not 401', () => pm.response.to.have.status(403));",
              "const body = pm.response.json();",
              "pm.test('the code is insufficient_scope', () => {",
              "  pm.expect(body.error).to.eql('insufficient_scope');",
              "});",
              "pm.test('it names the scope required and the ones held', () => {",
              "  pm.expect(body.message).to.include('reports:delete');",
              "  pm.expect(body.message).to.include('reports:read');",
              "});"
            ]}
          }]
        },
        {
          "name": "Scope the account cannot have (400)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "analyst" },
                { "key": "password", "value": "analyst-password" },
                { "key": "scope", "value": "reports:delete" }
              ]
            },
            "url": { "raw": "{{base_url}}/auth/token", "host": ["{{base_url}}"], "path": ["auth", "token"] },
            "description": "Asking for more than the account is entitled to is refused outright, rather than quietly granting less."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));",
              "pm.test('the code is invalid_scope', () => {",
              "  pm.expect(pm.response.json().error).to.eql('invalid_scope');",
              "});"
            ]}
          }]
        },
        {
          "name": "Missing report (404)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/reports/9999", "host": ["{{base_url}}"], "path": ["reports", "9999"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('404', () => pm.response.to.have.status(404));",
              "pm.test('the code is not_found', () => {",
              "  pm.expect(pm.response.json().error).to.eql('not_found');",
              "});"
            ]}
          }]
        }
      ]
    }
  ]
}
